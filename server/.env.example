# Copy this file to ".env" and fill it in. ".env" is private and never uploaded (.gitignore).

# MongoDB Atlas connection string. Leave it out to save to a JSON file instead.
# Replace USER, PASSWORD and the cluster address with your own. The "eventease" before "?" is the database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/eventease?retryWrites=true&w=majority

# Optional
# PORT=4000
# CLIENT_ORIGIN=http://localhost:5173

# Only for running the tests against MongoDB. Use a DIFFERENT database name than above
# so tests never touch your real events. Tests create and delete their own collection.
# TEST_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/eventease_test?retryWrites=true&w=majority
