{
  "name": "eventease-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API for EventEase (Express). Stores events in MongoDB (or a JSON file if MONGODB_URI is not set).",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "test": "node --env-file-if-exists=.env --test"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mongoose": "^9.12.2"
  }
}
